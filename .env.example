# Database URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transactions

# Redis URL (for Celery broker)
REDIS_URL=redis://localhost:6379/0

# Upload directory for CSV files
UPLOAD_DIR=./uploads

# Gemini LLM configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://gemini.googleapis.com/v1/models/gemini-1.5-flash:generateText

